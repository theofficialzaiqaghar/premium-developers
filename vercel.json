{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "premiumdevelopers.co" }],
      "destination": "https://www.premiumdevelopers.co/:path*",
      "permanent": true
    },
    {
      "source": "/contact.html",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/about.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/special-offer.html",
      "destination": "/special-offer/",
      "permanent": true
    },
    {
      "source": "/work/the-resumer.html",
      "destination": "/case-studies/the-resumer/",
      "permanent": true
    },
    {
      "source": "/blog/:slug([^/.]+)",
      "destination": "/blog/:slug/",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/special-offer",
      "destination": "/special-offer.html"
    },
    {
      "source": "/special-offer/",
      "destination": "/special-offer.html"
    },
    {
      "source": "/case-studies",
      "destination": "/case-studies/index.html"
    },
    {
      "source": "/case-studies/",
      "destination": "/case-studies/index.html"
    },
    {
      "source": "/case-studies/the-resumer",
      "destination": "/case-studies/the-resumer.html"
    },
    {
      "source": "/case-studies/the-resumer/",
      "destination": "/case-studies/the-resumer.html"
    },
    {
      "source": "/admin/blog",
      "destination": "/admin/blog/index.html"
    },
    {
      "source": "/admin/blog/",
      "destination": "/admin/blog/index.html"
    },
    {
      "source": "/sitemap-blog.xml",
      "destination": "/api/sitemap-blog"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    }
  ]
}
